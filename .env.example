# PostgreSQL კავშირის სტრიქონი (Neon ან Supabase-დან, უფასო tier საკმარისია)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth-ის დაშიფვრის საიდუმლო გასაღები. გენერაცია: openssl rand -base64 32
NEXTAUTH_SECRET="შეცვალეთ-ეს-შემთხვევითი-სტრიქონით"
NEXTAUTH_URL="http://localhost:3000"

